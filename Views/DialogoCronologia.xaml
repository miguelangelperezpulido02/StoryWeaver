<Window x:Class="Scriptorum.Views.DialogoCronologia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo evento" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F3EF">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtTituloVentana" Text="Nuevo evento" FontSize="16" FontWeight="SemiBold"
                   Foreground="#2B2D42" Margin="0,0,0,12"/>

        <TextBlock Text="Tipo de tarjeta" Foreground="#8A8578" Margin="0,0,0,2"/>
        <ComboBox x:Name="CboTipo" Margin="0,0,0,8" Padding="6" SelectedIndex="1">
            <ComboBoxItem Content="ACT"/>
            <ComboBoxItem Content="BEAT"/>
            <ComboBoxItem Content="SCENE"/>
            <ComboBoxItem Content="NOTE"/>
        </ComboBox>

        <TextBlock Text="Título" Foreground="#8A8578" Margin="0,0,0,2"/>
        <TextBox x:Name="TxtTitulo" Margin="0,0,0,8" Padding="6" MaxLength="150"/>

        <TextBlock Text="Descripción" Foreground="#8A8578" Margin="0,0,0,2"/>
        <TextBox x:Name="TxtDescripcion" Margin="0,0,0,8" Padding="6" MaxLength="2000"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="80"/>

        <TextBlock Text="Personaje vinculado (opcional)" Foreground="#8A8578" Margin="0,0,0,2"/>
        <ComboBox x:Name="CboPersonaje" Margin="0,0,0,12" Padding="6"/>
        <TextBlock Text="Nota asociada (opcional)" Foreground="#8A8578" Margin="0,0,0,2"/>
        <ComboBox x:Name="CboNota" Margin="0,0,0,8" Padding="6" IsEditable="True"
                  SelectionChanged="CboNota_SelectionChanged"/>

        <TextBlock x:Name="TxtError" Foreground="#D64545" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Padding="6" Click="Cancelar_Click"
                    Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"/>
            <Button x:Name="BtnAceptar" Content="Crear" Width="90" Padding="6" Click="Aceptar_Click"
                    Background="#5B7C99" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
