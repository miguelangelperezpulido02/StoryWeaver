<Window x:Class="Scriptorum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scriptorum"
        mc:Ignorable="d"
        Title="Scriptorum" Height="650" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="#F5F3EF"
        PreviewKeyDown="Ventana_Tecla"
        PreviewMouseLeftButtonDown="Ventana_ClickFueraMapa"
        Closing="Ventana_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Botones de formato de notas: fondo apagado, resaltado cuando está activo -->
        <Style x:Key="EstiloBotonFormato" TargetType="ToggleButton">
            <Setter Property="Background" Value="#45475E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#5B7C99"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Estilo coherente de nodo desde el prototipo -->
        <Style x:Key="EstiloNodo" TargetType="Border">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#FFFEFB"/>
            <Setter Property="BorderBrush" Value="#5B7C99"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#5B7C99"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="Pestanas" Margin="8" Background="#F5F3EF" BorderBrush="#D8D2C4"
                    SelectionChanged="Pestanas_SelectionChanged">
            <TabItem Header="Personajes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Listado lateral -->
                    <Border Grid.Column="0" Background="#2B2D42" CornerRadius="8" Margin="0,0,6,0" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Personajes" Foreground="#F5F3EF"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6" Padding="6"
                                         ToolTip="Nombre del nuevo personaje"/>
                                <TextBox Text="{Binding NuevoGrupo, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,6" Padding="6"
                                         ToolTip="Grupo o carpeta (opcional, ej. Familia)"/>
                                <Button Content="＋ Añadir personaje"
                                        Command="{Binding AnadirPersonajeCommand}"
                                        Padding="6" Background="#5B7C99" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Content="－ Eliminar personaje"
                                        Command="{Binding EliminarPersonajeCommand}"
                                        Margin="0,6,0,0" Padding="6" Background="#D64545" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="Elimina el personaje seleccionado y sus relaciones"/>
                            </StackPanel>
                            <ListBox x:Name="ListaPersonajes" ItemsSource="{Binding PersonajesVista}"
                                     SelectedItem="{Binding PersonajeSeleccionado, Mode=TwoWay}"
                                     Background="#343654" Foreground="#F5F3EF"
                                     BorderThickness="0" Padding="4"
                                     ToolTip="Arrastra sobre un grupo para moverlo; suelta en zona vacía para sacarlo"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="ListaPersonajes_MouseDown"
                                     PreviewMouseMove="ListaPersonajes_MouseMove"
                                     PreviewMouseLeftButtonUp="ListaPersonajes_MouseUp"
                                     DragOver="ListaPersonajes_DragOver"
                                     Drop="ListaPersonajes_Drop">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="AllowDrop" Value="True"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Border Background="{TemplateBinding Background}" Padding="0,0,0,6">
                                                                <StackPanel>
                                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                                    <ItemsPresenter/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <EventSetter Event="DragOver" Handler="Grupo_DragOver"/>
                                                <EventSetter Event="DragLeave" Handler="Grupo_DragLeave"/>
                                                <EventSetter Event="Drop" Handler="Grupo_Drop"/>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#F5F3EF"
                                                           FontWeight="Bold" Margin="0,6,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nombre}" Margin="14,1,0,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 2. Mapa central de nodos y relaciones -->
                    <Border x:Name="MarcoMapa" Grid.Column="1" Background="#FFFEFB" CornerRadius="8"
                            BorderBrush="#D8D2C4" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="False">
                                <TextBlock Text="Mapa de personajes" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#2B2D42" VerticalAlignment="Center"/>
                                <TextBlock Text="Rueda: zoom · Botón central: mover vista · Arrastra los nodos · Clic en línea para verla."
                                           Foreground="#8A8578" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontStyle="Italic"/>
                                <Button DockPanel.Dock="Right" Content="＋ Crear relación"
                                        Click="CrearRelacion_Click" Padding="10,4"
                                        Background="#2B2D42" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                    <Button Content="−" Width="30" Padding="0,2" Click="ZoomMenos_Click"
                                            Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"
                                            ToolTip="Alejar"/>
                                    <TextBlock x:Name="TxtZoom" Text="100%" Width="48" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="#2B2D42" FontWeight="SemiBold"/>
                                    <Button Content="＋" Width="30" Padding="0,2" Click="ZoomMas_Click"
                                            Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"
                                            ToolTip="Acercar"/>
                                    <Button Content="1:1" Width="36" Padding="0,2" Margin="4,0,0,0" Click="ZoomReset_Click"
                                            Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"
                                            ToolTip="Restablecer zoom (100%)"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Solo se dibujan relaciones creadas manualmente. -->
                            <Grid Grid.Row="1">
                            <ScrollViewer x:Name="VisorMapa" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" Background="#FFFEFB"
                                          PreviewMouseWheel="VisorMapa_Wheel"
                                          PreviewMouseDown="VisorMapa_MouseDown"
                                          PreviewMouseMove="VisorMapa_MouseMove"
                                          PreviewMouseUp="VisorMapa_MouseUp">
                                <Grid x:Name="SuperficieMapa" Width="4000" Height="4000" Background="#FFFEFB">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomMapa" ScaleX="1" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <Canvas x:Name="LienzoRelaciones" Width="4000" Height="4000"
                                            Background="Transparent" Panel.ZIndex="0"/>
                                    <ItemsControl x:Name="MapaItems" ItemsSource="{Binding Personajes}"
                                                  Background="Transparent" Panel.ZIndex="1">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding PosX, Mode=TwoWay}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding PosY, Mode=TwoWay}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource EstiloNodo}"
                                                        ToolTip="{Binding Nombre}"
                                                        PreviewMouseLeftButtonDown="Nodo_MouseLeftButtonDown"
                                                        PreviewMouseMove="Nodo_MouseMove"
                                                        PreviewMouseLeftButtonUp="Nodo_MouseLeftButtonUp">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Crear relación"
                                                                      Click="CrearRelacionDesdeNodo_Click"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <TextBlock Text="{Binding Nombre}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               FontWeight="SemiBold" Foreground="#2B2D42"
                                                               Margin="8,4"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                                <!-- Aviso del modo "crear relación": no intercepta clics. -->
                                <Border x:Name="AvisoModoRelacion" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                                        Background="#2B2D42" CornerRadius="14" Padding="12,6">
                                    <TextBlock x:Name="TxtAvisoRelacion" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. Panel de edicion (mostrar / ocultar) + proyectos -->
                    <Grid Grid.Column="2" Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Command="{Binding AlternarPanelCommand}" Margin="0,0,0,6" Padding="6"
                                Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Ocultar panel »"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PanelVisible}" Value="False">
                                            <Setter Property="Content" Value="« Mostrar panel"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HaySeleccion}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Grid.Row="1" Background="White" CornerRadius="8"
                                BorderBrush="#D8D2C4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding PanelVisible}" Value="True"/>
                                                <Condition Binding="{Binding HaySeleccion}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Ficha de personaje -->
                                    <StackPanel DataContext="{Binding PersonajeSeleccionado}">
                                        <TextBlock Text="Ficha de personaje" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2B2D42" Margin="0,0,0,8"/>
                                        <TextBlock Text="Nombre" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Nombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6" Margin="0,0,0,10"/>
                                        <TextBlock Text="Grupo" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Grupo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Padding="6" Margin="0,0,0,10"
                                                 ToolTip="Carpeta estilo Obsidian (vacío = Sin grupo)"/>
                                        <TextBlock Text="Posición en el mapa" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBlock Foreground="#2B2D42" Margin="0,0,0,10">
                                            <Run Text="X: "/><Run Text="{Binding PosX, StringFormat=F0}"/>
                                            <Run Text="   Y: "/><Run Text="{Binding PosY, StringFormat=F0}"/>
                                        </TextBlock>
                                        <Button Content="Guardar cambios"
                                                Command="{Binding DataContext.GuardarEdicionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="6" Background="#5B7C99" Foreground="White"
                                                BorderThickness="0" Cursor="Hand"/>
                                        <TextBlock Text="Selecciona un personaje de la lista o del mapa para editarlo."
                                                   Foreground="#8A8578" FontStyle="Italic" TextWrapping="Wrap" Margin="0,12,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Separator Margin="0,14"/>

                                    <!-- Relacion seleccionada: perspectivas + color -->
                                    <StackPanel DataContext="{Binding RelacionSeleccionada}">
                                        <TextBlock Text="Relación" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2B2D42" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DataContext.TextoRelacionSeleccionada, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="#2B2D42" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock Text="General" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DescripcionGeneral}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Cómo ve A a B" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DescripcionOrigenADestino}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Cómo ve B a A" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DescripcionDestinoAOrigen}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Color de la línea" Foreground="#8A8578" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding DataContext.ColoresDisponibles, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.NombreColorRelacion, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                  Padding="6" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Quitar selección" Padding="8,4" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.LimpiarSeleccionRelacionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"/>
                                            <Button Content="Eliminar" Padding="8,4"
                                                    Command="{Binding DataContext.EliminarRelacionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="#D64545" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                        <TextBlock Text="Haz clic en una línea del mapa para verla aquí."
                                                   Foreground="#8A8578" FontStyle="Italic" TextWrapping="Wrap" Margin="0,12,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="2" Background="White" CornerRadius="8"
                                BorderBrush="#D8D2C4" BorderThickness="1" Margin="0,6,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Proyecto" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#2B2D42" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Proyectos}"
                                          SelectedItem="{Binding ProyectoActual, Mode=TwoWay}"
                                          DisplayMemberPath="Nombre" Margin="0,0,0,6" Padding="4"
                                          ToolTip="Proyecto activo"/>
                                <UniformGrid Columns="3">
                                    <Button Content="Nuevo" Click="NuevoProyecto_Click" Margin="0,0,4,0" Padding="4"
                                            Background="#5B7C99" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Crear proyecto"/>
                                    <Button Content="Editar" Click="EditarProyecto_Click" Margin="0,0,4,0" Padding="4"
                                            Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"
                                            ToolTip="Editar nombre y descripción"/>
                                    <Button Content="Borrar" Click="EliminarProyecto_Click" Padding="4"
                                            Background="#D64545" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Eliminar proyecto"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Cronología">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="False">
                        <TextBlock Text="Líneas de tiempo" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#2B2D42" VerticalAlignment="Center"/>
                        <TextBlock Text="Doble clic en el nombre para renombrarlo · Arrastra tarjetas para ordenar."
                                   Foreground="#8A8578" Margin="12,0,0,0"
                                   VerticalAlignment="Center" FontStyle="Italic"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋ Nueva línea de tiempo" Click="NuevaLinea_Click" Padding="10,4"
                                    Background="#2B2D42" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Editar evento" Click="EditarEvento_Click" Padding="10,4" Margin="6,0,0,0"
                                    Background="Transparent" BorderBrush="#D8D2C4" Cursor="Hand"/>
                            <Button Content="Borrar evento" Click="EliminarEvento_Click" Padding="10,4" Margin="6,0,0,0"
                                    Background="#D64545" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F5F3EF" CornerRadius="8"
                            BorderBrush="#D8D2C4" BorderThickness="1" ClipToBounds="True">
                        <ScrollViewer x:Name="VisorCronologia"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#F5F3EF" Padding="16">
                            <StackPanel x:Name="PilaLineas"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Notas">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2B2D42" CornerRadius="8" Margin="0,0,6,0" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Notas" Foreground="#F5F3EF"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Button DockPanel.Dock="Top" Content="+ Nueva nota" Click="NuevaNota_Click"
                                    Margin="0,0,0,8" Padding="6"
                                    Background="#5B7C99" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button DockPanel.Dock="Bottom" Content="Borrar" Click="EliminarNota_Click"
                                    Margin="0,8,0,0" Padding="4"
                                    Background="#D64545" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                            <ListBox ItemsSource="{Binding Notas}"
                                     SelectedItem="{Binding NotaSeleccionada, Mode=TwoWay}"
                                     Background="#343654" Foreground="#F5F3EF"
                                     BorderThickness="0" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FechaCreacion, StringFormat=g}"
                                                       Foreground="#B8B4A8" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="8"
                            BorderBrush="#D8D2C4" BorderThickness="1" Padding="14">
                        <Grid DataContext="{Binding NotaSeleccionada}">
                            <!-- Estado vacío: invita a crear la primera nota -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Ninguna nota seleccionada" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#2B2D42" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="Elige una nota de la lista o crea una nueva para empezar a escribir. Los cambios se guardan solos."
                                           Foreground="#8A8578" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16"/>
                                <Button Content="+ Crear mi primera nota" Click="NuevaNota_Click" Padding="10,6"
                                        Background="#5B7C99" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Editor integrado: escribe directo, sin ventanas -->
                            <DockPanel LastChildFill="True">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Top" Text="Título" Foreground="#8A8578" Margin="0,0,0,2"/>
                                <TextBox DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8,6" MaxLength="150"
                                         FontSize="18" FontWeight="SemiBold" Foreground="#2B2D42"
                                         BorderBrush="#D8D2C4"
                                         Text="{Binding Titulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding FechaCreacion, StringFormat='Creada el {0:g}'}"
                                               Foreground="#8A8578" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding DataContext.EstadoGuardadoNotas, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                               Foreground="#5B7C99" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Left" Text="Contenido" Foreground="#8A8578"
                                               VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ToggleButton x:Name="BtnNegrita" Content="N" FontWeight="Bold"
                                                      Margin="0,0,4,0" Click="FormatoNegrita_Click"
                                                      ToolTip="Negrita (Ctrl+B)"
                                                      Style="{StaticResource EstiloBotonFormato}"/>
                                        <ToggleButton x:Name="BtnCursiva" Content="K" FontStyle="Italic"
                                                      Click="FormatoCursiva_Click" ToolTip="Cursiva (Ctrl+I)"
                                                      Style="{StaticResource EstiloBotonFormato}"/>
                                    </StackPanel>
                                </DockPanel>
                                <RichTextBox x:Name="CajaTexto" Padding="8,6" FontSize="13" Foreground="#2B2D42"
                                             BorderBrush="#D8D2C4" VerticalScrollBarVisibility="Auto"
                                             SpellCheck.IsEnabled="True" TextChanged="CajaTexto_TextChanged"
                                             SelectionChanged="CajaTexto_SelectionChanged"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
